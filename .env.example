# LLM Provider Configuration
# For OpenAI: get your key from https://platform.openai.com/api-keys
# For Qwen (DashScope): get your key from Alibaba Cloud
# For any OpenAI-compatible provider: set the base URL accordingly

OPENAI_API_KEY=sk-your-api-key-here

# Optional: base URL for OpenAI-compatible providers
# Examples:
#   OpenAI (default):  https://api.openai.com/v1
#   Qwen (DashScope):  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Local (Ollama):    http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model name
# Examples: gpt-4o, gpt-4o-mini, qwen-plus, qwen-turbo
OPENAI_MODEL=gpt-4o-mini

# Gemini STT Configuration (speech-to-text)
# Get your key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_STT_MODEL=gemini-3.5-transcribe
